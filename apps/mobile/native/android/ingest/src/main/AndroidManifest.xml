<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        El servicio se fusiona en el AndroidManifest del host app. Requiere el
        permiso especial BIND_NOTIFICATION_LISTENER_SERVICE y que el usuario lo
        habilite en Ajustes → Acceso a notificaciones.
    -->
    <application>
        <service
            android:name="com.yapi.ingest.YapiNotificationListenerService"
            android:exported="false"
            android:label="yapi"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
