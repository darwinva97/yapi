PORT=3001

# Basic Auth de la API protegida
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# Firebase Admin — usa UNA de estas opciones:
#  a) JSON de la service account en una sola línea:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"yapi-46b53","private_key":"...","client_email":"firebase-adminsdk-fbsvc@yapi-46b53.iam.gserviceaccount.com"}
#  b) Ruta al fichero serviceAccountKey.json (descargado de Firebase):
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json

# --- Base de datos ---
# Driver: "local" (SQLite clásico en fichero, desarrollo) o "d1-http" (Cloudflare D1, producción).
# Por defecto: "local" salvo que NODE_ENV=production.
DB_DRIVER=local
DATABASE_URL=file:./.data/local.db

# Cloudflare D1 (vía API HTTP) — sólo para DB_DRIVER=d1-http (producción)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
