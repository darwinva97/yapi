{
  "name": "@yapi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./d1": "./src/d1.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "drizzle-kit migrate --config drizzle.local.config.ts",
    "db:push:local": "drizzle-kit push --config drizzle.local.config.ts",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist migrations/meta"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@yapi/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
